# ComfyUI Server Configuration
# ----------------------------------------
# 1) 단일 인스턴스 (기본)
# COMFYUI_API_URL=https://your-comfyui-server.com

# ----------------------------------------
# 2) 한 포드에서 여러 GPU(포트) 사용 시
#    RunPod URL 형식: https://<포드ID>-<포트>.proxy.runpod.net
#    같은 포드 = URL에서 포드ID만 동일하고, 포트(8188,8189,8190,8191)만 다르게 적으면 됨.
#    예: 포드 ID가 abc123xyz 이고 4개 ComfyUI가 8188~8191 포트로 떠 있는 경우
COMFYUI_API_URL_1=https://abc123xyz-8188.proxy.runpod.net
COMFYUI_NAME_1=ComfyUI :8188
COMFYUI_API_URL_2=https://abc123xyz-8189.proxy.runpod.net
COMFYUI_NAME_2=ComfyUI :8189
COMFYUI_API_URL_3=https://abc123xyz-8190.proxy.runpod.net
COMFYUI_NAME_3=ComfyUI :8190
COMFYUI_API_URL_4=https://abc123xyz-8191.proxy.runpod.net
COMFYUI_NAME_4=ComfyUI :8191

# ----------------------------------------
# 3) 포드 여러 대 사용 시 (포드마다 다른 ID, 포트는 보통 8188 하나)
# COMFYUI_API_URL_1=https://pod1-8188.proxy.runpod.net
# COMFYUI_NAME_1=ComfyUI Pod 1
# COMFYUI_API_URL_2=https://pod2-8188.proxy.runpod.net
# COMFYUI_NAME_2=ComfyUI Pod 2

# Server Configuration
PORT=3002
NODE_ENV=development

# CORS Configuration (Frontend URL)
FRONTEND_URL=http://localhost:5174

# RunPod Configuration (Optional)
RUNPOD_API_KEY=your_runpod_api_key_here

# Batch Processing
DEFAULT_OUTPUT_FOLDER_PATH=./output

# BytePlus ModelArk — Seedance (일반 영상 탭)
# https://console.byteplus.com/ 등에서 발급
ARK_API_KEY=
# 엔드포인트 ID (프로젝트마다 다름). 자동화 멀티 큐용으로 최대 3개 지정 가능.
SEEDANCE_MODEL_ID=ep-20260225103736-hbdt8
# SEEDANCE_MODEL_ID_1=
# SEEDANCE_MODEL_ID_2=
# SEEDANCE_MODEL_ID_3=
# 선택: 기본은 아시아 리전 고정 URL
# BYTEPLUS_API_BASE=https://ark.ap-southeast.bytepluses.com
# 태스크 상태 폴링 최대 횟수(간격 5초). 기본 180 ≈ 15분. 최소 30.
# SEEDANCE_POLL_MAX_ATTEMPTS=180
# 오토메이션: 동일 잡 API 실패 시 재시도 상한. 0 또는 미설정 = 제한 없음(큐 강제 중지 전까지)
# SEEDANCE_AUTOMATION_MAX_ATTEMPTS_PER_JOB=0
