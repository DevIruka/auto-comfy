# ComfyUI instances
# ----------------------------------------
# COMFYUI_API_URL / COMFYUI_API_URL_1 … 는 사용하지 않음.
# 포드는 앱 Pod Dashboard에서 URL 또는 RunPod SSH 명령으로 등록한다.
#    예: ssh cg505wkcdmujxw-64410f6e@ssh.runpod.io -i ~/.ssh/id_ed25519
#    백엔드가 로컬 포트포워딩(ssh -N -L 127.0.0.1:<로컬>:127.0.0.1:8188)을 연다.
#    전제: 백엔드 PC에 OpenSSH 클라이언트와 RunPod에 등록된 키가 있어야 함.
#    멀티 GPU면 대시보드의 "원격 포트"에 8188,8189 처럼 쉼표로 입력.
#
# CivitAI LoRA 다운로드 (Pod Dashboard, SSH 인스턴스만)
# 저장 경로: /workspace/ComfyUI/models/loras
CIVITAI_API_KEY=

# Server Configuration
PORT=3002
NODE_ENV=development

# CORS Configuration (Frontend URL)
FRONTEND_URL=http://localhost:5174

# RunPod Configuration (Optional)
RUNPOD_API_KEY=your_runpod_api_key_here

# Batch Processing
DEFAULT_OUTPUT_FOLDER_PATH=./output

# BytePlus ModelArk — Seedance (일반 영상 탭)
# https://console.byteplus.com/ 등에서 발급
ARK_API_KEY=
# 엔드포인트 ID (프로젝트마다 다름). 자동화 멀티 큐용으로 최대 3개 지정 가능.
SEEDANCE_MODEL_ID=ep-20260225103736-hbdt8
# SEEDANCE_MODEL_ID_1=
# SEEDANCE_MODEL_ID_2=
# SEEDANCE_MODEL_ID_3=
# 선택: 기본은 아시아 리전 고정 URL
# BYTEPLUS_API_BASE=https://ark.ap-southeast.bytepluses.com
# 태스크 상태 폴링 최대 횟수(간격 5초). 기본 180 ≈ 15분. 최소 30.
# SEEDANCE_POLL_MAX_ATTEMPTS=180
# 오토메이션: 동일 잡 API 실패 시 재시도 상한. 0 또는 미설정 = 제한 없음(큐 강제 중지 전까지)
# SEEDANCE_AUTOMATION_MAX_ATTEMPTS_PER_JOB=0

# MuleRouter — WAN 2.7 Spicy I2V (성인용 영상 자동화 V2 탭)
# https://www.mulerouter.ai/docs/api-reference/endpoint/carrothub/wan2.7-i2v-spicy/generation
MULEROUTER_API_KEY=
# MULEROUTER_API_BASE=https://api.mulerouter.ai
# WAN27_RESOLUTION=1080p
# WAN27_DURATION=5
# WAN27_PROMPT_EXTEND=true
# WAN27_POLL_INTERVAL_MS=5000
# WAN27_POLL_MAX_ATTEMPTS=180
# WAN 2.2 Spicy options (used when V2 tab selects WAN 2.2). resolution: 480p|720p, duration: 5|8
# WAN22_RESOLUTION=480p
# WAN22_DURATION=5
# WAN22_PROMPT_EXTEND=true

# Alibaba DashScope — HappyHorse i2v (happyhorse 단일 영상 제작 탭)
# https://help.aliyun.com/en/model-studio/happyhorse-image-to-video-api-reference
# 필터는 서버에서 X-DashScope-DataInspection 헤더로 항상 비활성화됨.
DASHSCOPE_API_KEY=
# 선택 (기본값 있음). 싱가포르 리전은 intl 엔드포인트로 라우팅됨.
# DASHSCOPE_API_BASE=https://dashscope-intl.aliyuncs.com
# HAPPYHORSE_MODEL=happyhorse-1.1-i2v
# 태스크 상태 폴링 간격/최대 횟수. 기본 5000ms / 180회 ≈ 15분.
# HAPPYHORSE_POLL_INTERVAL_MS=5000
# HAPPYHORSE_POLL_MAX_ATTEMPTS=180
